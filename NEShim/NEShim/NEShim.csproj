<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <WarningsAsErrors>CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</WarningsAsErrors>
        <UseWindowsForms>false</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SDL3-CS" Version="3.*" />
        <PackageReference Include="SDL3-CS.MacOS" Version="3.4.12" />
        <PackageReference Include="SDL3-CS.MacOS.Image" Version="3.4.4.5" />
        <!-- Windows: SDL3 native DLL bundles -->
        <PackageReference Include="SDL3-CS.Windows" Version="3.*" Condition="'$(OS)' == 'Windows_NT'" />
        <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.*" Condition="'$(OS)' == 'Windows_NT'" />
        <PackageReference Include="SDL3-CS.Windows.Image" Version="3.*" Condition="'$(OS)' == 'Windows_NT'" />
        <!-- Linux: SDL3 native .so bundles -->
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.12" Condition="'$(OS)' != 'Windows_NT'" />
        <PackageReference Include="SDL3-CS.Linux.TTF" Version="3.*" Condition="'$(OS)' != 'Windows_NT'" />
        <PackageReference Include="SDL3-CS.Linux.Image" Version="3.4.4.5" Condition="'$(OS)' != 'Windows_NT'" />
        <!-- D3D11 renderer (Windows-only) -->
        <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" Condition="'$(OS)' == 'Windows_NT'" />
        <Reference Include="Steamworks.NET">
            <HintPath>lib\Steamworks.NET.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BizHawk\BizHawk.csproj" />
        <ProjectReference Include="..\NEShim.AchievementSigning\NEShim.AchievementSigning.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="icon.ico" />
        <EmbeddedResource Include="Assets\logos\neshim-logo-splash.png">
            <LogicalName>NEShim.Assets.logos.neshim-logo-splash.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\controllers\controller_none.png">
            <LogicalName>NEShim.Assets.controllers.controller_none.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\english.png">
            <LogicalName>NEShim.Assets.flags.english.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\french.png">
            <LogicalName>NEShim.Assets.flags.french.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\german.png">
            <LogicalName>NEShim.Assets.flags.german.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\spanish.png">
            <LogicalName>NEShim.Assets.flags.spanish.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\latam.png">
            <LogicalName>NEShim.Assets.flags.latam.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\japanese.png">
            <LogicalName>NEShim.Assets.flags.japanese.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\korean.png">
            <LogicalName>NEShim.Assets.flags.korean.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\russian.png">
            <LogicalName>NEShim.Assets.flags.russian.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\schinese.png">
            <LogicalName>NEShim.Assets.flags.schinese.png</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Assets\flags\portuguese.png">
            <LogicalName>NEShim.Assets.flags.portuguese.png</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Remove all shader files from SDK auto-includes before re-adding explicitly.
         The SDK wildcard patterns pick up all files in subdirectories and can cause
         duplicate EmbeddedResource items that strip LogicalName during deduplication. -->
    <ItemGroup>
        <EmbeddedResource Remove="Rendering\Shaders\**\*" />
        <None Remove="Rendering\Shaders\**\*" />
        <!-- HLSL sources: visible in the solution but not compiled into the assembly -->
        <None Include="Rendering\Shaders\Passthrough.vs.hlsl" />
        <None Include="Rendering\Shaders\Passthrough.ps.hlsl" />
        <None Include="Rendering\Shaders\CrtScanlines.ps.hlsl" />
        <None Include="Rendering\Shaders\CrtPhosphor.ps.hlsl" />
        <None Include="Rendering\Shaders\NtscComposite.ps.hlsl" />
        <None Include="Rendering\Shaders\Jinc2.ps.hlsl" />
        <None Include="Rendering\Shaders\CrtScreen.ps.hlsl" />
        <None Include="Rendering\Shaders\MagneticDistortion.ps.hlsl" />
        <None Include="Rendering\Shaders\Xbr.ps.hlsl" />
        <None Include="Rendering\Shaders\PhosphorPersistence.ps.hlsl" />
        <None Include="Rendering\Shaders\PictureAdjust.ps.hlsl" />
        <None Include="Rendering\Shaders\ColorGrade.hlsli" />
        <!-- Compiled shader bytecode — produced by CompileShaders target below.
             DXVK on Proton translates this DXBC bytecode to SPIR-V on first launch
             and caches it in ~/.local/share/Steam/steamapps/shadercache/<appid>/.
             No runtime fxc dependency; compilation happens at build time only. -->
        <EmbeddedResource Include="Rendering\Shaders\Passthrough.vs.cso">
            <LogicalName>NEShim.Rendering.Shaders.Passthrough.vs.cso</LogicalName>
        </EmbeddedResource>
        <!-- WithCulture=false prevents MSBuild from treating ".ps" as the Pashto
             culture code and splitting this into a satellite assembly. -->
        <EmbeddedResource Include="Rendering\Shaders\Passthrough.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.Passthrough.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\CrtScanlines.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.CrtScanlines.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\CrtPhosphor.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.CrtPhosphor.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\NtscComposite.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.NtscComposite.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Jinc2.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.Jinc2.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\CrtScreen.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.CrtScreen.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\MagneticDistortion.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.MagneticDistortion.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Xbr.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.Xbr.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\PhosphorPersistence.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.PhosphorPersistence.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\PictureAdjust.ps.cso">
            <LogicalName>NEShim.Rendering.Shaders.PictureAdjust.ps.cso</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <!-- SPIR-V bytecode for SDL_GPU path (Vulkan/Linux, Metal/macOS).
             Compiled from Shaders/Gpu/*.hlsl by the CompileSpirvShaders target below
             using the standalone DXC from the Microsoft.Direct3D.DXC NuGet package.
             Pre-compiled .spv files are checked in so builds work without DXC available. -->
        <None Include="Rendering\Shaders\Gpu\Passthrough.vs.hlsl" />
        <None Include="Rendering\Shaders\Gpu\Passthrough.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\CrtScanlines.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\CrtPhosphor.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\NtscComposite.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\CrtScreen.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\Jinc2.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\Xbr.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\MagneticDistortion.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\PhosphorPersistence.ps.hlsl" />
        <None Include="Rendering\Shaders\Gpu\PictureAdjust.ps.hlsl" />
        <EmbeddedResource Include="Rendering\Shaders\Gpu\Passthrough.vs.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.Passthrough.vs.spv</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\Passthrough.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.Passthrough.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\CrtScanlines.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.CrtScanlines.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\CrtPhosphor.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.CrtPhosphor.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\NtscComposite.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.NtscComposite.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\CrtScreen.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.CrtScreen.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\Jinc2.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.Jinc2.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\Xbr.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.Xbr.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\MagneticDistortion.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.MagneticDistortion.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\PhosphorPersistence.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.PhosphorPersistence.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Rendering\Shaders\Gpu\PictureAdjust.ps.spv">
            <LogicalName>NEShim.Rendering.Shaders.Gpu.PictureAdjust.ps.spv</LogicalName>
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
    </ItemGroup>

    <!-- Compile HLSL shaders to DXBC bytecode before building.
         Requires fxc.exe from the Windows SDK. The .cso files are committed to source
         control and embedded as resources above; recompilation only happens when a
         developer with a local Windows SDK modifies the .hlsl sources.
         On CI runners (no Windows SDK installed), the checked-in CSOs are used as-is. -->
    <Target Name="CompileShaders" BeforeTargets="CoreCompile"
            Inputs="$(MSBuildProjectDirectory)\Rendering\Shaders\Passthrough.vs.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Passthrough.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtScanlines.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtPhosphor.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\NtscComposite.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Jinc2.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtScreen.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\MagneticDistortion.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Xbr.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\PhosphorPersistence.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\PictureAdjust.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\ColorGrade.hlsli"
            Outputs="$(MSBuildProjectDirectory)\Rendering\Shaders\Passthrough.vs.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\Passthrough.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtScanlines.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtPhosphor.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\NtscComposite.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\Jinc2.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\CrtScreen.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\MagneticDistortion.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\Xbr.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\PhosphorPersistence.ps.cso;$(MSBuildProjectDirectory)\Rendering\Shaders\PictureAdjust.ps.cso">
        <PropertyGroup>
            <!-- Try common Windows SDK paths. $(WindowsSDKVersion) has no trailing backslash,
                 so we add one explicitly between the version segment and "x64". -->
            <_FxcPath Condition="Exists('$(WindowsSdkDir)bin\$(WindowsSDKVersion)\x64\fxc.exe')">$(WindowsSdkDir)bin\$(WindowsSDKVersion)\x64\fxc.exe</_FxcPath>
            <_FxcPath Condition="'$(_FxcPath)' == '' And Exists('$(WindowsSdkDir)bin\$(WindowsSDKVersion)x64\fxc.exe')">$(WindowsSdkDir)bin\$(WindowsSDKVersion)x64\fxc.exe</_FxcPath>
            <_FxcPath Condition="'$(_FxcPath)' == '' And Exists('$(WindowsSdkDir)bin\x64\fxc.exe')">$(WindowsSdkDir)bin\x64\fxc.exe</_FxcPath>
            <!-- _FxcFoundAtKnownPath is true only when fxc was located at an explicit SDK path.
                 Bare 'fxc.exe' (PATH fallback) is treated as "not found at a known path" so CI
                 runners that happen to have fxc.exe somewhere on PATH don't accidentally skip
                 the skip-logic below — they'll compile, which is fine. -->
            <_FxcFoundAtKnownPath Condition="'$(_FxcPath)' != ''">true</_FxcFoundAtKnownPath>
            <_FxcPath Condition="'$(_FxcPath)' == ''">fxc.exe</_FxcPath>
            <_ShaderDir>$(MSBuildProjectDirectory)\Rendering\Shaders</_ShaderDir>
            <!-- Skip recompilation when fxc was not found at a known SDK path AND the
                 pre-compiled CSOs already exist from source control. This keeps CI builds
                 working without a Windows SDK install. If CSOs are missing AND fxc is
                 unavailable, the Exec commands below will fail with a clear shell error. -->
            <_SkipShaderCompile Condition="'$(_FxcFoundAtKnownPath)' != 'true' And Exists('$(_ShaderDir)\Passthrough.vs.cso') And Exists('$(_ShaderDir)\Passthrough.ps.cso') And Exists('$(_ShaderDir)\CrtScanlines.ps.cso') And Exists('$(_ShaderDir)\CrtPhosphor.ps.cso') And Exists('$(_ShaderDir)\NtscComposite.ps.cso') And Exists('$(_ShaderDir)\Jinc2.ps.cso') And Exists('$(_ShaderDir)\CrtScreen.ps.cso') And Exists('$(_ShaderDir)\MagneticDistortion.ps.cso') And Exists('$(_ShaderDir)\Xbr.ps.cso') And Exists('$(_ShaderDir)\PhosphorPersistence.ps.cso') And Exists('$(_ShaderDir)\PictureAdjust.ps.cso')">true</_SkipShaderCompile>
        </PropertyGroup>
        <Message Text="[CompileShaders] fxc.exe not found at a Windows SDK path — using pre-compiled CSOs from source control."
                 Condition="'$(_SkipShaderCompile)' == 'true'"
                 Importance="High" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T vs_5_0 /E main /Fo &quot;$(_ShaderDir)\Passthrough.vs.cso&quot; &quot;$(_ShaderDir)\Passthrough.vs.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\Passthrough.ps.cso&quot; &quot;$(_ShaderDir)\Passthrough.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\CrtScanlines.ps.cso&quot; &quot;$(_ShaderDir)\CrtScanlines.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\CrtPhosphor.ps.cso&quot; &quot;$(_ShaderDir)\CrtPhosphor.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\NtscComposite.ps.cso&quot; &quot;$(_ShaderDir)\NtscComposite.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\Jinc2.ps.cso&quot; &quot;$(_ShaderDir)\Jinc2.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\CrtScreen.ps.cso&quot; &quot;$(_ShaderDir)\CrtScreen.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\MagneticDistortion.ps.cso&quot; &quot;$(_ShaderDir)\MagneticDistortion.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\Xbr.ps.cso&quot; &quot;$(_ShaderDir)\Xbr.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\PhosphorPersistence.ps.cso&quot; &quot;$(_ShaderDir)\PhosphorPersistence.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
        <Exec Command="&quot;$(_FxcPath)&quot; /nologo /T ps_5_0 /E main /Fo &quot;$(_ShaderDir)\PictureAdjust.ps.cso&quot; &quot;$(_ShaderDir)\PictureAdjust.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipShaderCompile)' != 'true'" />
    </Target>

    <!-- Compile SDL_GPU HLSL shaders to SPIR-V for the Vulkan/Linux and Metal/macOS render paths.
         Requires dxc.exe from the Microsoft.Direct3D.DXC NuGet package (standalone DXC with SPIR-V
         codegen enabled — the Windows SDK dxc.exe lacks SPIR-V support).
         Pre-compiled .spv files are checked in and used when DXC is not found. -->
    <Target Name="CompileSpirvShaders" BeforeTargets="CoreCompile"
            Inputs="$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Passthrough.vs.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Passthrough.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtScanlines.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtPhosphor.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\NtscComposite.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtScreen.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Jinc2.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Xbr.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\MagneticDistortion.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\PhosphorPersistence.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\PictureAdjust.ps.hlsl;$(MSBuildProjectDirectory)\Rendering\Shaders\ColorGrade.hlsli"
            Outputs="$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Passthrough.vs.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Passthrough.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtScanlines.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtPhosphor.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\NtscComposite.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\CrtScreen.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Jinc2.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\Xbr.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\MagneticDistortion.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\PhosphorPersistence.ps.spv;$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu\PictureAdjust.ps.spv">
        <PropertyGroup>
            <!-- Prefer the standalone DXC from the Microsoft.Direct3D.DXC NuGet package
                 (must be restored via "dotnet restore" or by adding it as a PackageReference).
                 The NuGet package is NOT referenced directly in this project to avoid adding a
                 runtime dependency — it is a build-time-only tool. Restore it in a side project
                 or with "dotnet restore" against a packages.lock.json to get the DXC path. -->
            <_SpirvDxcPath Condition="Exists('$(NuGetPackageRoot)microsoft.direct3d.dxc\101.7.2207.25\build\native\bin\x64\dxc.exe')">$(NuGetPackageRoot)microsoft.direct3d.dxc\101.7.2207.25\build\native\bin\x64\dxc.exe</_SpirvDxcPath>
            <_SpirvDxcFoundAtKnownPath Condition="'$(_SpirvDxcPath)' != ''">true</_SpirvDxcFoundAtKnownPath>
            <_SpirvGpuDir>$(MSBuildProjectDirectory)\Rendering\Shaders\Gpu</_SpirvGpuDir>
            <!-- Skip recompilation when DXC is not available and pre-compiled SPVs already exist. -->
            <_SkipSpirvCompile Condition="'$(_SpirvDxcFoundAtKnownPath)' != 'true' And Exists('$(_SpirvGpuDir)\Passthrough.ps.spv') And Exists('$(_SpirvGpuDir)\CrtScanlines.ps.spv')">true</_SkipSpirvCompile>
        </PropertyGroup>
        <Message Text="[CompileSpirvShaders] DXC with SPIR-V support not found — using pre-compiled SPVs from source control."
                 Condition="'$(_SkipSpirvCompile)' == 'true'"
                 Importance="High" />
        <Exec Command="&quot;$(_SpirvDxcPath)&quot; /nologo -spirv -T vs_6_0 -E main -Fo &quot;$(_SpirvGpuDir)\Passthrough.vs.spv&quot; &quot;$(_SpirvGpuDir)\Passthrough.vs.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipSpirvCompile)' != 'true'" />
        <Exec Command="&quot;$(_SpirvDxcPath)&quot; /nologo -spirv -T ps_6_0 -E main -Fo &quot;$(_SpirvGpuDir)\Passthrough.ps.spv&quot; &quot;$(_SpirvGpuDir)\Passthrough.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipSpirvCompile)' != 'true'" />
        <Exec Command="&quot;$(_SpirvDxcPath)&quot; /nologo -spirv -T ps_6_0 -E main -Fo &quot;$(_SpirvGpuDir)\CrtScanlines.ps.spv&quot; &quot;$(_SpirvGpuDir)\CrtScanlines.ps.hlsl&quot;"
              CustomErrorRegularExpression="error X"
              Condition="'$(_SkipSpirvCompile)' != 'true'" />
        <Exec Command="&quot;$(_SpirvDxcPath)&quot; /nologo -spirv -T ps_6_0 -E main -Fo &quot;$(_SpirvGpuDir)\CrtPhosphor.ps.spv&quot; &quot;$(_SpirvGpuDir)\CrtPhosphor.ps.hlsl&quot;"
