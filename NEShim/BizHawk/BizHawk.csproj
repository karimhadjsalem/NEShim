<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <NoWarn>CS8981;CS9191</NoWarn>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DefineConstants>$(DefineConstants);BIZHAWKBUILD_GAMEDB_ALWAYS_MISS</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
      <DefineConstants>$(DefineConstants);BIZHAWKBUILD_GAMEDB_ALWAYS_MISS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Emulation\Cores\Consoles\NIntendo\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    </ItemGroup>

	<ItemGroup>
		<Using Include="System" />
	</ItemGroup>

    <!-- Native DLLs required by P/Invoke in the emulation core.
         _IsLinuxTarget is true when cross-publishing with -r linux-x64 or building natively on Linux.
         Linux .so files live in dll/linux-x64/ and are NOT committed — see dll/linux-x64/README.md. -->
    <PropertyGroup>
        <_IsLinuxTarget Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</_IsLinuxTarget>
        <_IsLinuxTarget Condition="'$(_IsLinuxTarget)' == '' And '$(OS)' != 'Windows_NT'">true</_IsLinuxTarget>
    </PropertyGroup>

    <ItemGroup Condition="'$(_IsLinuxTarget)' != 'true'">
        <Content Include="$(MSBuildProjectDirectory)/dll/blip_buf.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>blip_buf.dll</Link>
        </Content>
        <Content Include="$(MSBuildProjectDirectory)/dll/libbizhash.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>libbizhash.dll</Link>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(_IsLinuxTarget)' == 'true'">
        <Content Include="$(MSBuildProjectDirectory)/dll/linux-x64/libblip_buf.so"
                 Condition="Exists('$(MSBuildProjectDirectory)/dll/linux-x64/libblip_buf.so')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>libblip_buf.so</Link>
        </Content>
        <Content Include="$(MSBuildProjectDirectory)/dll/linux-x64/libbizhash.so"
                 Condition="Exists('$(MSBuildProjectDirectory)/dll/linux-x64/libbizhash.so')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>libbizhash.so</Link>
        </Content>
    </ItemGroup>

</Project>
